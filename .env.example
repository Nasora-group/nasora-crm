# Copie ce fichier en ".env" pour le développement local (ne jamais committer le vrai .env)

# Clé secrète Flask - OBLIGATOIRE en production. Génère-en une avec :
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Environnement : development | production
FLASK_ENV=development

# Base de données :
# - En local (par défaut si absent) : sqlite:///instance/plateforme_commerciale.db
# - En production (Render/Railway/Heroku) : ils fournissent automatiquement DATABASE_URL (Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mots de passe des comptes créés au premier démarrage (seed).
# Change-les avant tout déploiement réel !
SEED_ADMIN_PASSWORD=change-me-admin
SEED_DEFAULT_COMMERCIAL_PASSWORD=change-me-commercial
